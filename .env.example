NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://pos:pos@localhost:5432/pos
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_me_with_32_or_more_chars_xxxxxxxx
COOKIE_SECRET=replace_me_with_32_or_more_chars_xxxxxxxx
SESSION_COOKIE_NAME=pos_access
WEB_ORIGIN=http://localhost:3000
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_TILL_NUMBER=600000
MPESA_STORE_NUMBER=1
MPESA_CONFIRMATION_URL=https://your-public-url/mpesa/confirmation
MPESA_VALIDATION_URL=https://your-public-url/mpesa/validation
SAFARICOM_ALLOWED_CIDRS=
INTERNAL_HMAC_SECRET=replace_me_with_32_or_more_chars_xxxxxxxx

# ───── eTIMS (KRA fiscal) — all optional, all inert by default ─────
# Mock server is used only by tests/dev when explicitly enabled.
# Production tenants must configure their own KRA PIN + eTIMS mode via /etims admin (008D).
ETIMS_MOCK_ENABLED=false
ETIMS_SANDBOX_BASE_URL=https://etims-api-sbx.kra.go.ke/etims-api
ETIMS_PRODUCTION_BASE_URL=https://etims-api.kra.go.ke/etims-api
ETIMS_DEVICE_TIMEOUT_MS=15000
ETIMS_RETRY_MAX_ATTEMPTS=5
ETIMS_RETRY_BACKOFF_MS=2000
